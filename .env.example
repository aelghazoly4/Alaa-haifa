# Copy these into Vercel → Project → Settings → Environment Variables

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wedding

# Dashboard login password (what the client types at /admin)
ADMIN_PASSWORD=change-me

# Long random string used to sign the login cookie (16+ chars), e.g. output of: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string
